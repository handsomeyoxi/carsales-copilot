# ===== 伺服器 =====
PORT=3000

# ===== 語音轉文字引擎 STT_PROVIDER =====
# groq   ：免費，Groq 上的 whisper-large-v3（預設）
# openai ：付費，gpt-4o-transcribe
# breeze ：免費但要自架 asr-server（Breeze-ASR-26，台語較佳）
# hybrid ：雲端 + breeze 都跑，LLM 合併（HYBRID_CLOUD 指定雲端用 groq 或 openai）
# mock   ：測試用，不聽音檔，回傳模擬對話（src/mock/conversations.json），不需要金鑰
STT_PROVIDER=groq
# STT_MODEL=whisper-large-v3        # 想換模型時再取消註解，例如 whisper-large-v3-turbo（較快、稍不準）
BREEZE_ASR_URL=http://localhost:8001
HYBRID_CLOUD=groq

# ===== 文字整理 LLM_PROVIDER =====
# gemini ：免費，Google Gemini（預設，中文表現好）
# groq   ：免費，llama-3.3-70b-versatile
# openai ：付費，gpt-4o
# mock   ：測試用，不呼叫 AI，直接用模擬對話寫好的整理結果
LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.8-flash        # 想換模型時再取消註解

# STT_PROVIDER=mock 時預設用哪一段模擬對話（family-suv / commuter-ev / elder-tradein）
# 前端建立對話時 body 帶 mockScript 可以每次指定
MOCK_SCRIPT=family-suv

# ===== 本機測試模式（前端還沒接 Firebase 登入時用）=====
# SKIP_AUTH=true     ：跳過登入驗證，所有請求都當成 DEV_UID 這個測試帳號（NODE_ENV=production 時自動失效）
# USE_MEMORY_DB=true ：不連 Firebase，資料存在記憶體，伺服器重開就清空（不需要 serviceAccountKey.json）
# 兩個都設 true，就只需要填下面的 GROQ_API_KEY、GEMINI_API_KEY 就能跑
SKIP_AUTH=false
USE_MEMORY_DB=false
DEV_UID=dev-salesperson

# ===== API 金鑰（只要填你有用到的）=====
# 換新金鑰後跑 npm run check:keys 確認
# Groq：https://console.groq.com/keys
GROQ_API_KEY=
# Gemini：https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenAI（付費，可留空）
OPENAI_API_KEY=

# ===== Firebase（只有正式跑 API 伺服器才需要；scripts/test-local.js 不需要）=====
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
SAVE_AUDIO=true
